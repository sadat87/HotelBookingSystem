# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hotel_management?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-this-in-production-min-32-chars
JWT_REFRESH_EXPIRE=30d
